#!/usr/bin/env python3
"""Bound a spec command on both macOS and Linux.

Only the `-k GRACE SECONDS COMMAND...` form used by the FIFO spec is accepted.
"""

import math
import os
import signal
import subprocess
import sys


def main() -> int:
    if len(sys.argv) < 5 or sys.argv[1] != "-k":
        print("usage: timeout -k GRACE SECONDS COMMAND...", file=sys.stderr)
        return 125
    try:
        grace = float(sys.argv[2])
        seconds = float(sys.argv[3])
        if not math.isfinite(grace) or not math.isfinite(seconds) or grace < 0 or seconds <= 0:
            raise ValueError
    except ValueError:
        print("timeout requires a positive duration and nonnegative grace", file=sys.stderr)
        return 125

    try:
        process = subprocess.Popen(sys.argv[4:], start_new_session=True)
    except FileNotFoundError:
        return 127
    except PermissionError:
        return 126
    try:
        return process.wait(timeout=seconds)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(process.pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
        try:
            process.wait(timeout=grace)
        except subprocess.TimeoutExpired:
            try:
                os.killpg(process.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            process.wait()
        return 124


if __name__ == "__main__":
    sys.exit(main())
